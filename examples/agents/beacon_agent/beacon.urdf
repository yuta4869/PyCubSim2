<?xml version="1.0"?>
<robot name="beacon_agent">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.6"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.11" length="0.08"/></geometry>
      <material name="teal"><color rgba="0.05 0.58 0.48 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04"/>
      <geometry><cylinder radius="0.11" length="0.08"/></geometry>
    </collision>
  </link>
  <link name="stem">
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="0.15"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
      <material name="dark"><color rgba="0.12 0.18 0.17 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.035" length="0.20"/></geometry>
    </collision>
  </link>
  <joint name="stem_fixed" type="fixed">
    <parent link="base"/>
    <child link="stem"/>
    <origin xyz="0 0 0.08"/>
  </joint>
  <link name="head">
    <inertial>
      <mass value="0.25"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.10"/></geometry>
      <material name="coral"><color rgba="0.94 0.30 0.22 1"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.10"/></geometry>
    </collision>
  </link>
  <joint name="head_yaw" type="revolute">
    <parent link="stem"/>
    <child link="head"/>
    <origin xyz="0 0 0.24"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="4" velocity="3"/>
  </joint>
</robot>

