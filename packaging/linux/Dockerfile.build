FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        appstream \
        desktop-file-utils \
        dpkg-dev \
        file \
        libfontconfig1 \
        libfuse2 \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libx11-6 \
        libxcb1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-tk \
        xauth \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-build.txt /tmp/pycubsim2/
RUN python3 -m pip install --no-cache-dir \
        -r /tmp/pycubsim2/requirements.txt \
        -r /tmp/pycubsim2/requirements-build.txt

WORKDIR /workspace
